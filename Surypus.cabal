cabal-version: 3.4
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        GPL-3.0-or-later
build-type:     Simple

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
    Core.Payroll.Calculation
    DAL.Classifiers
    DAL.Conversion
    DAL.Database
    DAL.EventStore
    DAL.Mutations
    DAL.MutationsORM
    DAL.Payroll
    DAL.Pool
    DAL.Procedures
    DAL.Queries
    DAL.QueriesORM
    DAL.Repository.RBAC
    DAL.Schema
    DAL.Types
    Finance.Accounting
    Finance.Tax
    MultiTenancy.Isolation
    MultiTenancy.Middleware
    Service.PayrollService
    Surypus
    Surypus.API.Accounting
    Surypus.API.AuthMiddleware
    Surypus.API.Authorization
    Surypus.API.BillTemplates
    Surypus.API.Bills
    Surypus.API.CRM
    Surypus.API.Classifiers
    Surypus.API.Dashboard
    Surypus.API.Goods
    Surypus.API.GraphQL
    Surypus.API.Integrations
    Surypus.API.Logger
    Surypus.API.MetricsMiddleware
    Surypus.API.Notifications
    Surypus.API.Orders
    Surypus.API.Payment
    Surypus.API.Payroll
    Surypus.API.Persons
    Surypus.API.Push
    Surypus.API.RateLimiter
    Surypus.API.Reports
    Surypus.API.Server
    Surypus.API.Stock
    Surypus.API.Workflow
    Surypus.Core
    Surypus.CoreTypes
    Surypus.JWT
    Surypus.JWT.Token
    Surypus.Metrics
    Surypus.RBAC
    Surypus.RefreshTokenRepo
    Surypus.WebSocket

executable surypus-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , wai
    , wai-extra
    , warp
    , aeson
    , text
    , bytestring
    , http-types
    , time
    , directory
    , filepath
    , Decimal
    , network
  default-extensions: OverloadedStrings


executable ai-report
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: ai-report.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , text
    , aeson
    , time
  default-extensions: OverloadedStrings
test-suite surypus-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  other-modules:
      Finance.TaxSpec
      Finance.AccountingSpec
  build-depends:
      base >=4.12 && <5
      , Surypus
      , hspec
      , QuickCheck
      , text
      , time
      , aeson
      , bytestring
      , stm
      , containers
      , Decimal
  default-language: Haskell2010