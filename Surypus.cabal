cabal-version: 3.4
name:           Surypus
version:        0.1.0.0
synopsis:       Formally verified ERP system core
description:    Surypus - formally verified ERP system
category:       Finance
author:         Surypus Team
license:        MPL-2.0
build-type:     Simple

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
    Core.Payroll.Calculation
    DAL.Database
    DAL.Document
    DAL.Pool
    DAL.Schema
    DAL.Types
    Finance.Accounting
    Finance.Bill
    Finance.Tax
    HR.Address
    HR.Activity
    HR.Contact
    HR.Employee
    HR.Goals.Goal
    HR.Position
    HR.PersonEx
    HR.Relation
    HR.Salary
    Commerce.Bonus
    Commerce.BonusPoints
    Commerce.CashRegister
    Commerce.Notes.Comment
    Commerce.Package
    Commerce.PriceByTime
    Commerce.PriceRule
    Commerce.Promo
    Commerce.ServiceBill
    Commerce.Visits.Visit
    Core.DSL
    Core.DSL.AST
    Core.DSL.Parser
    Core.Optimization
    DAL.Attachment
    DAL.Blockchain
    DAL.File
    DAL.Migration
    Domain.Accounting.Events
    Shared.Export.Exporter
    External.EGais.EGais
    External.Jasper.Jasper
    External.Pentaho.Pentaho
    External.EGAIS
    External.UHTT.UhttStore
    External.VETIS
    DAL.Agent
    DAL.DAL
    DAL.ORMPool
    DAL.Production
    DAL.Repository
    DomainFinance
    Finance.Types
    Infrastructure.Backup
    Infrastructure.Migration
    Infrastructure.Notification
    Infrastructure.Serializer
    Infrastructure.EmailSender
    Finance.AccPlan
    Finance.Bank
    Finance.BankAccount
    Finance.CreditNote
    Finance.Currency
    Finance.DebitNote
    Finance.ExchangeRate
    Integration
    Integration.EDI.EDI
    Integration.Integration
    Integration.Sync
    Integration.Webhook
    Integration.Health
    Inventory.Article
    Inventory.Barcode
    Inventory.Brand
    Inventory.Category
    Inventory.City
    Inventory.Country
    Inventory.Location
    Inventory.Region
    Inventory.GoodsLoc
    Inventory.Inventory
    Inventory.GoodsReceipt
    Inventory.GoodsEx
    Inventory.GoodsTaxEx
    Inventory.InventoryEx
    Core.Accounting.Cache
    DAL.DB
    HR.Person
    Commerce.Invoice
    DAL.Repository.RBAC
    DAL.SchemaStubs
    DAL.UUIDOrphans
    DigitalTwin.TwinSystem
    Finance.AccMask
    Finance.Account
    Commerce.BillStatusEx
    Commerce.BillTaxDiffs
    Commerce.Loyalty
    Commerce.Bundle
    Commerce.CashSessionTemp
    Commerce.Combo
    Commerce.PaymentCard
    Commerce.PriceByAgent
    Commerce.PriceByQtty
    Commerce.PriceList
    Commerce.RetBill
    Commerce.Return
    Commerce.Shipment
    Commerce.Orders.Order
    Commerce.Orders.Quotation
    Commerce.Price
    Core.Core
    Core.Inventory
    Core
    Core.Tax
    Surypus
    Surypus.CoreTypes
    Surypus.JWT
    Surypus.Metrics
    Surypus.RBAC
    Surypus.RefreshTokenRepo

  build-depends:
    base >=4.12 && <5
    , aeson
    , bytestring
    , text
    , time
    , Decimal
    , persistent
    , persistent-postgresql
    , persistent-template
    , esqueleto
    , monad-logger
    , wai
    , wai-extra
    , warp
    , http-types
    , directory
    , filepath
    , network
    , containers
    , transformers
    , mtl
    , stm
    , uuid
    , lens
    , katip
    , jose
    , cryptonite
    , yaml
    , servant
    , servant-server
    , resource-pool
    , QuickCheck
    , hspec

executable surypus-server
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.12 && <5
    , Surypus
    , wai
    , wai-extra
    , warp
    , aeson
    , text
    , bytestring
    , http-types
    , time
    , directory
    , filepath
    , Decimal
    , network
  default-extensions: OverloadedStrings



test-suite surypus-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Test.hs
  other-modules:
      Finance.TaxSpec
      Finance.AccountingSpec
      Finance.BillSpec
  build-depends:
      base >=4.12 && <5
      , Surypus
      , hspec
      , QuickCheck
      , text
      , time
      , aeson
      , bytestring
      , stm
      , containers
      , Decimal
  default-language: Haskell2010
